{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "esnext.decorators", "esnext.disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
