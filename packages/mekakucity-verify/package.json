{
  "name": "@mekakucity/verify",
  "version": "0.3.1",
  "description": "Runtime conformance suite for @mekakucity/actors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js",
      "default": "./dist/effect/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RanolP/npm-packages",
    "directory": "packages/mekakucity-verify"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests"
  },
  "author": "RanolP <me@ranolp.dev>",
  "license": "MIT",
  "peerDependencies": {
    "@mekakucity/actors": ">=0.0.0 <1",
    "effect": "^4.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mekakucity/actors": "workspace:*",
    "@types/node": "^24.0.1",
    "effect": "^4.0.5",
    "typescript": "catalog:",
    "vitest": "^4.1.0"
  },
  "files": [
    "src/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "actor",
    "actor-model",
    "conformance"
  ]
}
